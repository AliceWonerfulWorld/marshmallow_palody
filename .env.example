# 部会向けVercel公開テスト: 同じClerk Development instanceのpk_test/sk_testを設定
# 正式なProduction移行後: 同じClerk Production instanceのキーを設定
# ローカル/Previewでは独立したDevelopment instanceのキーを使用
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# サーバー専用。NEXT_PUBLIC_ prefixを付けない
CLERK_SECRET_KEY=

# 部会向けVercel公開テストではConvex DevelopmentのURLを設定
# 正式なProduction移行後はConvex ProductionのURLを設定
# ローカルではnpx convex devが設定するDevelopment URL
NEXT_PUBLIC_CONVEX_URL=

# Convex Dashboardの各deploymentに設定（Vercel/.env.localだけでは反映されない）
# Clerk Frontend API URL。ProductionではProduction instanceのissuer
CLERK_JWT_ISSUER_DOMAIN=

# ローカル開発用。CLIが設定する識別子。本番Vercelにコピーしない
CONVEX_DEPLOYMENT=

# 任意: VercelからConvexもdeployする場合のみProduction scopeに設定
# サーバー/build専用のsecret。通常のNext buildには不要
CONVEX_DEPLOY_KEY=
